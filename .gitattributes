# Shell scripts must keep LF or they break under bash on Linux/macOS
*.sh text eol=lf
install.sh text eol=lf

# Everything else: normalize in the repo, let checkout decide locally
* text=auto
*.md text
*.json text
*.yml text

# Ignore PowerShell/Shell scripts
*.ps1 linguist-detectable=false
*.sh linguist-detectable=false